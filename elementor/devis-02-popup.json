            "__globals__": {
              "text_color": "globals/colors?id=text"
            }
          },
          "elements": []
        },
        {
          "id": "d3v1s20",
          "elType": "widget",
          "widgetType": "form",
          "settings": {
            "form_name": "Demande de devis produit",
            "form_fields": [
              {
                "_id": "prenom",
                "custom_id": "prenom",
                "field_type": "text",
                "field_label": "Prénom",
                "width": "50",
                "required": "true",
                "placeholder": "Prénom *"
              },
              {
                "_id": "nom",
                "custom_id": "nom",
                "field_type": "text",
                "field_label": "Nom",
                "width": "50",
                "required": "true",
                "placeholder": "Nom *"
              },
              {
                "_id": "email",
                "custom_id": "email",
                "field_type": "email",
                "field_label": "Email",
                "width": "50",
                "required": "true",
                "placeholder": "Email *"
              },
              {
                "_id": "telephone",
                "custom_id": "telephone",
                "field_type": "tel",
                "field_label": "Téléphone",
                "width": "50",
                "required": "true",
                "placeholder": "Téléphone *"
              },
              {
                "_id": "date_fete",
                "custom_id": "date_fete",
                "field_type": "date",
                "field_label": "Date de la fête",
                "width": "50",
                "required": "",
                "placeholder": "Date de la fête"
              },
              {
                "_id": "nb_enfants",
                "custom_id": "nb_enfants",
                "field_type": "number",
                "field_label": "Nombre d'enfants",
                "width": "50",
                "required": "",
                "placeholder": "Nombre d'enfants",
                "min": "1"
              },
              {
                "_id": "demande",
                "custom_id": "demande",
                "field_type": "textarea",
                "field_label": "Votre demande",
                "width": "100",
                "required": "true",
                "placeholder": "Votre demande : ville, horaire souhaité, âge des enfants, options, questions…",
                "rows": "4"
              },
              {
                "_id": "rgpd",
                "custom_id": "rgpd",
                "field_type": "acceptance",
                "field_label": "Consentement",
                "width": "100",
                "required": "true",
                "acceptance_text": "J'accepte d'être recontacté(e) par AlphaBaby au sujet de ma demande."
              },
              {
                "_id": "produit",
                "custom_id": "produit",
                "field_type": "hidden",
                "field_label": "Prestation",
                "width": "100",
                "field_value": "",
                "__dynamic__": {
                  "field_value": "[elementor-tag id=\"prd0001\" name=\"post-title\" settings=\"%7B%7D\"]"
                }
              }
            ],
            "button_text": "Envoyer ma demande",
            "button_size": "md",
            "button_width": "100",
            "button_align": "center",
